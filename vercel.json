{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -- site",
  "outputDirectory": "dist/site",
  "redirects": [
    {"source": "/", "has": [{"type": "host", "value": "snipray.vercel.app"}], "destination": "https://skipcam.vercel.app/", "permanent": true},
    {"source": "/", "has": [{"type": "host", "value": "snipray.selfgraphic.tech"}], "destination": "https://skipcam.selfgraphic.tech/", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "snipray.vercel.app"}], "destination": "https://skipcam.vercel.app/:path*", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "snipray.selfgraphic.tech"}], "destination": "https://skipcam.selfgraphic.tech/:path*", "permanent": true}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
    ]}
  ]
}
